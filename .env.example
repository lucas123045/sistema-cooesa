# Copie para .env.local e preencha com os valores do projeto no Supabase
# (Project Settings → API). Nunca commite valores reais.

# URL do projeto (pública, vai para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anon/publishable (pública; o acesso é controlado pelo RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — SÓ no servidor e nos scripts (seed, criar-admin).
# Ignora o RLS. Nunca use em código de cliente nem com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo da rota /api/keep-alive (Vercel Cron envia como "Authorization: Bearer <CRON_SECRET>").
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# String de conexão do Postgres — só para o backup (GitHub Actions, pg_dump).
# Project Settings → Database → Connection string → Session pooler.
# No GitHub fica como secret do repositório, não aqui.
SUPABASE_DB_URL=
